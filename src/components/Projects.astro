---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="index" class="relative py-16 md:py-24">
  <div class="mx-auto max-w-[1440px] px-6 md:px-10">
    <div class="grid grid-cols-12 items-end gap-6">
      <div class="col-span-12 md:col-span-8">
        <div class="eyebrow">§ 01 / Index of Instruments</div>
        <h2 class="display mt-4 text-[56px] md:text-[96px]">
          The <span class="display-italic">catalogue</span>.
        </h2>
      </div>
      <div class="col-span-12 md:col-span-4">
        <p
          class="mono text-[12.5px] leading-[1.65] text-[color:var(--color-ink-soft)]"
        >
          Each entry is a standalone release — a single instrument, open-source,
          and usable from a terminal, an API, or an agent's tool-call. The
          catalogue grows slowly, on purpose.
        </p>
      </div>
    </div>

    <div class="mt-10 rule-thick"></div>
    <div
      class="mono grid grid-cols-12 gap-4 py-3 text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-mute)]"
    >
      <div class="col-span-1">No.</div>
      <div class="col-span-4 md:col-span-3">Instrument</div>
      <div class="hidden md:col-span-2 md:block">Language</div>
      <div class="hidden md:col-span-2 md:block">License</div>
      <div class="col-span-7 md:col-span-4 text-right">Interfaces / Status</div>
    </div>
    <div class="rule"></div>

    <ol>
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index + 1} />
      ))}
    </ol>

    <div class="rule"></div>

    <div
      class="mt-6 flex flex-col items-start justify-between gap-4 md:flex-row md:items-center"
    >
      <p
        class="mono max-w-[48ch] text-[12px] leading-[1.65] text-[color:var(--color-ink-soft)]"
      >
        More instruments in the workshop. If you want to commission one, open an
        issue or a letter.
      </p>
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/UseAnyXYZ"
          target="_blank"
          rel="noopener noreferrer"
          class="mono inline-flex items-center gap-2 border border-[color:var(--color-rule)] px-4 py-2.5 text-[11px] uppercase tracking-[0.22em] hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-paper)]"
        >
          Follow the org
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
