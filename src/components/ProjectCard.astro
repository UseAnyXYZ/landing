---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const n = String(index).padStart(2, "0");
---

<li
  class="group relative border-b border-[color:var(--color-rule)] transition-colors hover:bg-[color:var(--color-paper-deep)]"
>
  <div class="grid grid-cols-12 gap-4 py-8">
    <div class="col-span-1">
      <span class="mono text-[12px] tracking-[0.2em] text-[color:var(--color-ink)]">
        {n}
      </span>
    </div>

    <div class="col-span-11 md:col-span-3">
      <h3 class="display text-[36px] md:text-[44px] leading-[0.98]">
        {project.name}
      </h3>
      <div
        class="mono mt-2 flex flex-wrap items-center gap-2 text-[10.5px] uppercase tracking-[0.22em] text-[color:var(--color-mute)] md:hidden"
      >
        <span>{project.language}</span>
        <span>·</span>
        <span>{project.license}</span>
      </div>
    </div>

    <div class="hidden md:col-span-2 md:block">
      <span class="mono text-[12px] uppercase tracking-[0.18em]">
        {project.language}
      </span>
    </div>

    <div class="hidden md:col-span-2 md:block">
      <span
        class="mono inline-block border border-[color:var(--color-rule)] px-2 py-0.5 text-[10px] uppercase tracking-[0.22em]"
      >
        {project.license}
      </span>
    </div>

    <div class="col-span-12 md:col-span-4">
      <p
        class="text-[15px] leading-[1.6] text-[color:var(--color-ink-soft)] md:text-[15.5px]"
      >
        {project.description}
      </p>
      <ul class="mono mt-4 flex flex-wrap gap-x-3 gap-y-2 text-[11px] uppercase tracking-[0.2em]">
        {project.tags.map((tag) => (
          <li class="flex items-center gap-2">
            <span
              class="inline-block h-1.5 w-1.5 rotate-45 bg-[color:var(--color-vermilion)]"
            ></span>
            {tag}
          </li>
        ))}
      </ul>
      <div class="mt-5 flex flex-wrap gap-3">
        {project.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mono inline-flex items-center gap-2 border border-[color:var(--color-rule)] px-3 py-1.5 text-[11px] uppercase tracking-[0.22em] transition-colors hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-paper)]"
          >
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</li>
