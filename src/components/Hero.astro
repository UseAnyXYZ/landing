---
---

<section class="relative">
  <div class="mx-auto max-w-[1440px] px-6 pt-10 pb-12 md:px-10 md:pt-16 md:pb-20">
    <div class="grid grid-cols-12 gap-6">
      <aside class="col-span-12 md:col-span-3">
        <div class="flex items-start justify-between md:flex-col md:gap-10">
          <div>
            <div class="eyebrow">§ 00 / Preface</div>
            <p
              class="mono mt-3 max-w-[22ch] text-[12px] leading-[1.55] text-[color:var(--color-ink-soft)]"
            >
              An open-source studio building soft machines — instruments that AI
              agents and humans operate in parallel, without asking permission
              from either.
            </p>
          </div>
          <div class="hidden md:block">
            <div class="eyebrow">Filed under</div>
            <ul
              class="mono mt-2 space-y-1 text-[12px] text-[color:var(--color-ink-soft)]"
            >
              <li>— Agents</li>
              <li>— Infrastructure</li>
              <li>— Interfaces</li>
              <li>— Public Protocols</li>
            </ul>
          </div>
        </div>
      </aside>

      <div class="col-span-12 md:col-span-9">
        <h1 class="display text-[18vw] md:text-[11vw] lg:text-[168px]">
          <span class="block">Tools that</span>
          <span class="block">
            <span class="display-italic">agents</span>
            <span class="inline-flex translate-y-[-0.08em] items-center align-middle">
              <span
                class="mono ml-4 inline-block rounded-full border border-[color:var(--color-rule)] px-3 py-1 align-middle text-[11px] uppercase tracking-[0.22em] md:ml-6"
              >
                &amp; humans
              </span>
            </span>
          </span>
          <span class="block">
            can both use<span
              class="text-[color:var(--color-vermilion)]">.</span>
          </span>
        </h1>

        <div class="mt-10 grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-7">
            <p
              class="text-[16px] leading-[1.55] text-[color:var(--color-ink-soft)] md:text-[18px]"
            >
              UseAny is a publishing house for software. We ship
              <em class="display-italic text-[color:var(--color-ink)]"
                >small, sharp instruments</em
              >
              with two faces — a terminal for humans, a contract for machines —
              so the same operation runs in a shell, a webhook, or a model's
              tool call without translation.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#index"
                class="invert-chip mono inline-flex items-center gap-2 px-4 py-2.5 text-[11px] uppercase tracking-[0.22em] transition-colors hover:bg-[color:var(--color-vermilion)]"
              >
                Enter the index
                <span aria-hidden="true">→</span>
              </a>
              <a
                href="https://github.com/UseAnyXYZ"
                target="_blank"
                rel="noopener noreferrer"
                class="mono inline-flex items-center gap-2 border border-[color:var(--color-rule)] px-4 py-2.5 text-[11px] uppercase tracking-[0.22em] hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-paper)]"
              >
                Source on GitHub
                <span aria-hidden="true">↗</span>
              </a>
              <div
                class="mono flex items-center gap-2 pl-2 text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-mute)]"
              >
                <span class="blink">▌</span>
                <span>await any(input)</span>
              </div>
            </div>
          </div>

          <div class="col-span-12 md:col-span-5">
            <div class="hairline-box h-full p-5">
              <div class="flex items-center justify-between">
                <span class="eyebrow">Terminal / 01</span>
                <span
                  class="mono text-[10px] tracking-[0.2em] uppercase text-[color:var(--color-mute)]"
                >
                  sh · rest · mcp
                </span>
              </div>
              <pre
                class="mono mt-4 whitespace-pre-wrap break-words text-[12.5px] leading-[1.65] text-[color:var(--color-ink)]"><span class="text-[color:var(--color-vermilion)]">$</span> any calendar add \
  --when "tomorrow 09:00" \
  --title "Ship the index"

<span class="text-[color:var(--color-mute)]">→ event.created  id=ev_9f2a</span>
<span class="text-[color:var(--color-mute)]">→ ics.feed       updated</span>
<span class="text-[color:var(--color-mute)]">→ agent.tool     ok</span>

<span class="text-[color:var(--color-vermilion)]">$</span> <span class="blink">▌</span></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1440px] px-6 md:px-10"><div class="rule"></div></div>
</section>
