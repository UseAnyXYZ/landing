---
const year = new Date().getFullYear();
---

<footer class="relative">
  <div class="mx-auto max-w-[1440px] px-6 md:px-10">
    <div class="rule"></div>

    <div
      class="mono flex flex-col items-start justify-between gap-3 py-6 text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink-soft)] sm:flex-row sm:items-center"
    >
      <span>© {year} UseAny — All tools free as in freedom.</span>
      <div class="flex items-center gap-5">
        <a
          class="underline-hover"
          href="https://github.com/UseAnyXYZ"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </div>
</footer>
